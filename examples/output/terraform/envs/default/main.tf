# Environment default: one block per module (generated by AWS Resource Inventory).

module "iam" {
  source = "../../modules/iam"
}

module "observability" {
  source = "../../modules/observability"
}

module "network" {
  source = "../../modules/network"
}

module "edge" {
  source = "../../modules/edge"

  security_group_ids = module.network.security_group_ids
  subnet_ids         = module.network.subnet_ids
  vpc_ids            = module.network.vpc_ids
}

module "data" {
  source = "../../modules/data"

  security_group_ids = module.network.security_group_ids
}

module "compute" {
  source = "../../modules/compute"

  iam_role_arns        = module.iam.iam_role_arns
  lb_target_group_arns = module.edge.lb_target_group_arns
  security_group_ids   = module.network.security_group_ids
  sqs_queue_arns       = module.data.sqs_queue_arns
  subnet_ids           = module.network.subnet_ids
}
