  capacity_rebalance        = false
  protect_from_scale_in     = false

  launch_template {
    id      = aws_launch_template.worker.id
    version = "$Default"
  }
  tag {
    key                 = "service"
    value               = "storefront"
    propagate_at_launch = true
  }
}

