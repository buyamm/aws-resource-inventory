# Resource: aws_sfn_state_machine.order_flow
# Source specification: aws_sfn_state_machine/us-east-1/order-flow.json
# ARN: arn:aws:states:us-east-1:123456789012:stateMachine:order-flow
# Region: us-east-1
# mapped: definition, name, roleArn, stateMachineArn, tags
# unmapped: creationDate
# unmapped: status
resource "aws_sfn_state_machine" "order_flow" {
  name       = "order-flow"
  role_arn   = var.iam_role_arns["order_lambda_role"]
  definition = <<-EOT
    {
      "StartAt": "Process",
      "States": {
        "Process": {
          "End": true,
          "Resource": "arn:aws:lambda:us-east-1:123456789012:function:order-processor",
          "Type": "Task"
        }
      }
    }
  EOT

  tags = {
    "team" = "orders"
  }
}

# Resource: aws_cloudwatch_event_rule.nightly_report
# Source specification: aws_cloudwatch_event_rule/us-east-1/storefront-nightly-report.json
# ARN: arn:aws:events:us-east-1:123456789012:rule/storefront-nightly-report
# Region: us-east-1
# mapped: Arn, Description, EventBusName, Name, ScheduleExpression, State, Tags, Targets
# unmapped: CreatedBy
resource "aws_cloudwatch_event_rule" "nightly_report" {
  name                = "storefront-nightly-report"
  description         = "Nightly order report"
  schedule_expression = "cron(0 2 * * ? *)"
  state               = "ENABLED"

  tags = {
    "service" = "storefront"
  }
}

resource "aws_cloudwatch_event_target" "nightly_report_order_processor" {
  rule      = aws_cloudwatch_event_rule.nightly_report.name
  target_id = "order-processor"
  arn       = aws_lambda_function.order_processor.arn
}

# Resource: aws_scheduler_schedule.cleanup
# Source specification: aws_scheduler_schedule/us-east-1/default_storefront-cleanup.json
# ARN: arn:aws:scheduler:us-east-1:123456789012:schedule/default/storefront-cleanup
# Region: us-east-1
# mapped: Arn, Description, FlexibleTimeWindow, GroupName, Name, ScheduleExpression, State, Target
# unmapped: CreationDate
# unmapped: LastModificationDate
resource "aws_scheduler_schedule" "cleanup" {
  name                = "storefront-cleanup"
  group_name          = "default"
  description         = "Hourly cleanup message"
  schedule_expression = "rate(1 hour)"
  state               = "ENABLED"

  flexible_time_window {
    mode = "OFF"
  }
  target {
    arn      = var.sqs_queue_arns["orders"]
    role_arn = var.iam_role_arns["scheduler_role"]
    input    = "{\"task\": \"cleanup\"}"
    retry_policy {
      maximum_event_age_in_seconds = 86400
      maximum_retry_attempts       = 185
    }
  }
}
