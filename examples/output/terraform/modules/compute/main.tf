resource "aws_autoscaling_group" "workers" {
  name                      = "storefront-workers"
  min_size                  = 1
  max_size                  = 2
  desired_capacity          = 1
  default_cooldown          = 300
  health_check_type         = "EC2"
  health_check_grace_period = 300
  vpc_zone_identifier       = [var.subnet_ids["orders_private_a"]]
