# Resource: aws_ecr_repository.web
# Source specification: aws_ecr_repository/us-east-1/storefront-web.json
# ARN: arn:aws:ecr:us-east-1:123456789012:repository/storefront-web
# Region: us-east-1
# mapped: encryptionConfiguration, imageScanningConfiguration, imageTagMutability, registryId, repositoryArn, repositoryName, repositoryUri, tags
# unmapped: createdAt
resource "aws_ecr_repository" "web" {
  name                 = "storefront-web"
  image_tag_mutability = "IMMUTABLE"

  image_scanning_configuration {
    scan_on_push = true
  }
  encryption_configuration {
    encryption_type = "AES256"
  }

  tags = {
    "service" = "storefront"
  }
}

